From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hermes Agent <hermes@nousresearch.com>
Date: Mon, 09 Nov 2026 03:45:00 +0100
Subject: [PATCH] libgpg-error: rename awk variable 'namespace' (gawk >= 5.1 builtin)

gawk >= 5.1 reserves 'namespace' as a builtin, so passing
'-v namespace=errnos_' in src/Makefile.in is fatal:

    gawk: fatal: cannot use gawk builtin `namespace' as variable name

Rename the variable to 'gpg_error_namespace' in src/mkstrtable.awk and the
corresponding -v assignment in src/Makefile.in. Minimal root-cause fix,
package version and SHA256 unchanged.

--- a/src/mkstrtable.awk	2026-11-09 03:45:46.661884215 +0100
+++ b/src/mkstrtable.awk	2026-11-09 03:45:46.665882234 +0100
@@ -77,7 +77,7 @@
 #
 # The variable prefix can be used to prepend a string to each message.
 #
-# The variable namespace can be used to prepend a string to each
+# The variable gpg_error_namespace can be used to prepend a string to each
 # variable and macro name.
 
 BEGIN {
@@ -102,7 +102,7 @@
       print "/* The purpose of this complex string table is to produce";
       print "   optimal code with a minimum of relocations.  */";
       print "";
-      print "static const char " namespace "msgstr[] = ";
+      print "static const char " gpg_error_namespace "msgstr[] = ";
       header = 0;
     }
   else
@@ -150,7 +150,7 @@
   else
     print "  gettext_noop (\"" last_msgstr "\");";
   print "";
-  print "static const int " namespace "msgidx[] =";
+  print "static const int " gpg_error_namespace "msgidx[] =";
   print "  {";
   for (i = 0; i < coded_msgs; i++)
     print "    " pos[i] ",";
@@ -158,7 +158,7 @@
   print "  };";
   print "";
   print "static GPG_ERR_INLINE int";
-  print namespace "msgidxof (int code)";
+  print gpg_error_namespace "msgidxof (int code)";
   print "{";
   print "  return (0 ? 0";
 

--- a/src/Makefile.in	2026-11-09 03:45:46.661884215 +0100
+++ b/src/Makefile.in	2026-11-09 03:45:46.665882234 +0100
@@ -1615,7 +1615,7 @@
 
 errnos-sym.h: Makefile mkstrtable.awk errnos.in
 	$(AWK) -f $(srcdir)/mkstrtable.awk -v textidx=2 -v nogettext=1 \
-		-v prefix=GPG_ERR_ -v namespace=errnos_ \
+		-v prefix=GPG_ERR_ -v gpg_error_namespace=errnos_ \
 		$(srcdir)/errnos.in >$@
 
 mkheader$(EXEEXT_FOR_BUILD): mkheader.c Makefile
